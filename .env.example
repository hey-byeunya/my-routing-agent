# 어느 백엔드로 돌릴지. openai | claude | opencode | ollama | replay
# 비워 두면 openai 로 시도하고, 키가 없으면 replay 로 떨어진다.
AGENT_BACKEND=openai

# 모델. AGENT_MODEL 은 위 AGENT_BACKEND 로 지정한 백엔드에만 적용된다 —
# 백엔드마다 모델 이름 체계가 달라 가로질러 쓰면 "claude 에 gpt-4o-mini" 가 된다.
# 다른 백엔드의 모델을 바꾸려면 AGENT_MODEL_CLAUDE 처럼 백엔드별로 적는다.
AGENT_MODEL=
# AGENT_MODEL_OPENAI=gpt-4o-mini
# AGENT_MODEL_CLAUDE=haiku
# AGENT_MODEL_OLLAMA=qwen2.5:3b

# openai — 유일하게 유료 키가 필요한 백엔드
OPENAI_API_KEY=

# claude — 키가 필요 없다. claude CLI 의 구독 로그인을 그대로 쓴다.
#   설치 확인: claude --version
#   기본 모델: haiku

# opencode — 키가 필요 없다. opencode CLI 의 자격증명을 그대로 쓴다.
#   설치 확인: opencode --version / opencode auth list
#   기본 모델: opencode/nemotron-3.5-lightning-free (무료)
OPENCODE_BIN=opencode

# ollama — 로컬. 서버가 떠 있어야 한다 (ollama list 로 확인).
OLLAMA_BASE_URL=http://localhost:11434/v1
